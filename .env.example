# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Settings > API no painel do Supabase.
#
# Só a chave anon/publishable entra aqui. A service_role NUNCA: ela ignora
# o RLS e este build é estático, então tudo que estiver aqui vai parar no
# JavaScript público do site.
# Só a URL do projeto, SEM caminho. A supabase-js acrescenta /rest/v1
# sozinha — colar a "API URL" com o caminho gera /rest/v1/rest/v1 e o
# Supabase responde "Invalid path specified in request URL". O código
# tolera as duas formas, mas o certo é esta.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
