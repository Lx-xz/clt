# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Settings > API no painel do Supabase.
#
# Só a chave anon/publishable entra aqui. A service_role NUNCA: ela ignora
# o RLS e este build é estático, então tudo que estiver aqui vai parar no
# JavaScript público do site.
# Só a URL do projeto, SEM caminho. A supabase-js acrescenta /rest/v1
# sozinha — colar a "API URL" com o caminho gera /rest/v1/rest/v1 e o
# Supabase responde "Invalid path specified in request URL". O código
# tolera as duas formas, mas o certo é esta.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# ---------------------------------------------------------------- contas
# Não há variável nova para as contas: e-mail/senha e Google são ligados no
# painel do Supabase, não aqui. O que precisa estar configurado lá:
#
#  1. Authentication > Providers > Email — ligado. Enquanto "Confirm email"
#     estiver ligado, quem se cadastra só entra depois de clicar no link do
#     e-mail; desligar acelera os testes.
#  2. Authentication > Providers > Google — ligado, com o Client ID e o
#     Client Secret de um projeto do Google Cloud. No Google, a "Authorized
#     redirect URI" é https://SEU-PROJETO.supabase.co/auth/v1/callback.
#  3. Authentication > URL Configuration > Redirect URLs — acrescente os
#     endereços de onde o site é aberto, senão o login volta para o lugar
#     errado:
#       http://localhost:3000/
#       https://lx-xz.github.io/clt/
