# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Settings > API no painel do Supabase.
#
# Só a chave anon/publishable entra aqui. A service_role NUNCA: ela ignora
# o RLS e este build é estático, então tudo que estiver aqui vai parar no
# JavaScript público do site.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
